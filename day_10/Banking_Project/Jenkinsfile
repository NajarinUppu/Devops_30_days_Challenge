pipeline {

    agent any

    environment {

        APP_NAME = "banking-app"

        VERSION = "v1"

        DOCKER_REPO = "najarin31/banking_project"

    }

    stages {

        stage('Clone') {

            steps {

                echo 'Cloning Banking Application'
            }
        }

        stage('Build') {

            steps {

                echo 'Building Application'
            }
        }

        stage('Test') {

            steps {

                echo 'Executing Tests'
            }
        }

        stage('Package') {

            steps {

                echo 'Generating bank-app.jar'
            }
        }

        stage('Docker Build') {

            steps {

                echo "Building ${DOCKER_REPO}/${APP_NAME}:${VERSION}"
            }
        }

        stage('Docker Push') {

            steps {

                echo "Pushing ${DOCKER_REPO}/${APP_NAME}:${VERSION}"
            }
        }
    }

    post {

        success {

            echo 'Banking Application Pipeline Successful'
        }

        failure {

            echo 'Banking Application Pipeline Failed'
        }
    }
}

