pipeline {
	agent any 
	environment {
		APP_NAME ="Banking App"
		VERSION = "v1"
	}
	stages {
		stage('clone') {

			steps {
				echo ' Cloning Bank App'
			}

		}
		stage('build'){ 
			steps{
			echo "Building ${APP_NAME}:${VERSION}"
			}
		}


		stage('Test'){
			steps{
			echo " Executing Unit Tests"
			}
		}

		stage('Package')
		{
			steps {
			echo "Generating Artifact"
			}
		}
		
		post {
			success {

			echo " Successfully Build Banking Pipeline"

			}
			failure {
			echo " Banking Build failed"
			}
		}
		}
		}
